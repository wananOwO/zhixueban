# Judge0 配置（只列出与默认值不同或必须设置的项；其余见官方 judge0.conf）。
# 复制为 deploy/judge0/judge0.conf，权限 600；三个口令各用 32 位随机字符串（openssl rand -hex 16）。

# 访问认证：智学伴请求时带 X-Auth-Token，值与 /etc/zhixueban/env 的 JUDGE0_TOKEN 相同
AUTHN_TOKEN=请改成随机字符串
# 管理接口不开放
AUTHZ_TOKEN=

# 学生代码不能联网，且不允许单次提交覆盖这个设置
ENABLE_NETWORK=false
ALLOW_ENABLE_NETWORK=false
# 不回调外部地址、不接受额外文件、不允许删除提交
ENABLE_CALLBACKS=false
ENABLE_ADDITIONAL_FILES=false
ENABLE_SUBMISSION_DELETE=false

# 资源上限（与默认值一致，写明以便核对）
CPU_TIME_LIMIT=5
WALL_TIME_LIMIT=10
MEMORY_LIMIT=128000
MAX_PROCESSES_AND_OR_THREADS=60
MAX_FILE_SIZE=1024
MAX_QUEUE_SIZE=100

# 内部服务口令（不能为空）
REDIS_HOST=redis
REDIS_PASSWORD=请改成随机字符串
POSTGRES_HOST=db
POSTGRES_DB=judge0
POSTGRES_USER=judge0
POSTGRES_PASSWORD=请改成随机字符串

# 官方默认开启遥测；比赛站点关闭
JUDGE0_TELEMETRY_ENABLE=false
