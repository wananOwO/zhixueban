# 智学伴线上站环境变量（复制为 /etc/zhixueban/env，权限 600，属主 root）
# 只放部署配置；用户的模型 Key 不在这里（只保存在评委浏览器与服务器内存）。

# 运行模式：online = 公网访问码 + 每浏览器独立空间
VL_MODE=online
# 公网地址：https:// + 已备案域名，不带路径与结尾斜杠
VL_PUBLIC_ORIGIN=https://learn.example.cn
# 访问码：8–128 位，写进评审材料；更换后所有已登录浏览器需要重新输入
VL_ACCESS_CODE=请改成至少8位的访问码

# 数据库：必须位于应用目录的 data/ 内（程序拒绝 data 以外的路径与符号链接）
DB_PATH=data/app.db
# 示例课程：新空间登录时自动复制；文件不存在时跳过
VL_SAMPLE_PATH=data/sample/course.json

# 判题服务（Judge0，见 deploy/judge0）：未配置时编程题不可用，选择题、填空题不受影响
JUDGE0_URL=http://127.0.0.1:2358
JUDGE0_TOKEN=与 judge0.conf 的 AUTHN_TOKEN 相同

NODE_ENV=production
# 不要设置 LLM_API_KEY：线上模式不使用服务器上的模型 Key
