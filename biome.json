{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"includes": [
			"src/app/**",
			"!src/app/api",
			"src/components/**",
			"src/lib/api/**",
			"src/lib/stores/**",
			"src/lib/hooks/**",
			"src/lib/nav.ts",
			"src/lib/utils.ts",
			"src/lib/roadmap.ts",
			"src/lib/tape.ts",
			"src/lib/citations.ts",
			"tests/frontend/**",
			"tests/e2e/**",
			"!**/*.css"
		]
	},
	"formatter": { "enabled": false },
	"assist": { "enabled": false },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"a11y": { "preset": "recommended" },
			"suspicious": { "noArrayIndexKey": "off" },
			"style": { "noNonNullAssertion": "off", "useTemplate": "off" }
		}
	}
}


