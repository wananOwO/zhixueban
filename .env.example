# LLM 配置（必填其一）
LLM_PROVIDER=openai-compatible        # 或 anthropic
LLM_MODEL=deepseek-chat               # deepseek-chat / glm-4 / gpt-4o-mini 等
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=

# Embedding（默认同 LLM_BASE_URL）
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=

# 可选：Python 代码判题执行器（VPS 自部署 Judge0）
JUDGE0_URL=

# 可选：本地 Obsidian vault 路径（仅本地部署时生效）
OBSIDIAN_VAULT_PATH=

# 可选：公网演示模式（设置只读、限额、会话隔离）
DEMO_MODE=false
